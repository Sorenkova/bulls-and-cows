{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "start": "tsc && npx --yes serve public"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
