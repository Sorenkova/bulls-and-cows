{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "public/js",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"]
}
